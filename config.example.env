# Copie ce fichier en config.env puis remplis-le.
# Format : CLE=valeur, sans guillemets, une variable par ligne.

# --- Obligatoire ---------------------------------------------------------------

# ID de ton projet Google Cloud (visible en haut de la console GCP)
PROJECT_ID=mon-projet-gcp

# Compte Google utilisé par gcloud, si tu en as plusieurs (voir « gcloud auth list »)
GCLOUD_ACCOUNT=

# Une ou plusieurs playlists YouTube publiques, séparées par des virgules
PLAYLISTS=https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxx

# --- Optionnel -----------------------------------------------------------------

# Nom du dossier créé dans ton Google Drive
DRIVE_FOLDER_NAME=DJ - YouTube

# Région Google Cloud (europe-west1 = Belgique, incluse dans le niveau gratuit)
REGION=europe-west1

# Heure du lancement quotidien, au format cron (ici : tous les jours à 6h)
SCHEDULE=0 6 * * *
TIME_ZONE=Europe/Paris

# Qualité MP3 en kbps
AUDIO_BITRATE=320

# Nombre max de morceaux par lancement (0 = illimité)
MAX_DOWNLOADS_PER_RUN=0

# Proxy si YouTube bloque Google Cloud (voir Dépannage dans le README), ex. http://user:pass@host:port
PROXY_URL=
